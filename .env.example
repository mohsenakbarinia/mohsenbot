# ==========================================
# NEXORA AI — Environment Configuration
# ==========================================
# Never commit .env files with real secrets.

# --- Application ---
APP_ENV=development
APP_SECRET=CHANGE_ME_GENERATE_64_CHAR_RANDOM_HEX
APP_URL=http://localhost:3000
APP_DEBUG=false
DOMAIN_NAME=nexora.example.com

# --- Google Gemini API (Server-Side Only) ---
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-4-hydrogen
GEMINI_REASONING_MODEL=gemini-4-argon
GEMINI_DEEP_REASONING_MODEL=gemini-4-carbon
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
GEMINI_AUDIO_MODEL=gemini-3.5-transcribe
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Telegram Bot & Mini App ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINIAPP_URL=

# --- Database (PostgreSQL + pgvector for Docker / SQLite path for local applet) ---
DATABASE_URL=postgresql+asyncpg://nexora:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/nexora_ai
POSTGRES_USER=nexora
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=nexora_ai
SQLITE_DB_PATH=./data/nexora.db

# --- Redis ---
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Admin Security & Bootstrap ---
JWT_SECRET=CHANGE_ME_GENERATE_JWT_SECRET
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
SESSION_TTL_SECONDS=43200

# --- Optional Local AI Provider (Ollama / GGUF) ---
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://ollama:11434
LOCAL_AI_MODEL=qwen2.5:7b-instruct

# --- Storage & Limits ---
STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE=20971520
TEMP_FILE_TTL_MINUTES=30
LOG_LEVEL=INFO
WEB_SEARCH_PROVIDER=gemini_grounding
WEB_SEARCH_API_KEY=
